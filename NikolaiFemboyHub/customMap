local InsertService = game:GetService("InsertService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Aguarda o RemoteEvent
local remoteEvent = ReplicatedStorage:WaitForChild("CarregarMapaEvent")

local function carregarMapa(player: Player, assetId: number)
	-- Segurança: só o criador do jogo pode carregar
	if player.UserId ~= game.CreatorId then
		warn("[CarregarMapa] Acesso negado para:", player.Name)
		return
	end

	print("[CarregarMapa] Carregando asset ID:", assetId)

	local success, result = pcall(function()
		return InsertService:LoadAsset(assetId)
	end)

	if not success then
		warn("[CarregarMapa] Erro:", result)
		return
	end

	-- Remove mapa anterior
	local mapaAnterior = workspace:FindFirstChild("MapaCarregado")
	if mapaAnterior then
		mapaAnterior:Destroy()
	end

	-- Insere novo mapa
	result.Name = "MapaCarregado"
	result.Parent = workspace

	for _, obj in ipairs(result:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Anchored = true
		end
	end

	print("[CarregarMapa] Mapa carregado com sucesso!")
end

remoteEvent.OnServerEvent:Connect(carregarMapa)
